# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/ai-skillpath-dev

# CORS Configuration (optional, default: *)
CORS_ORIGIN=*

# JWT Configuration (must be at least 16 characters)
JWT_SECRET=your_jwt_secret_key_at_least_16_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration (optional, backend-only secret)
GEMINI_API_KEY=your_gemini_api_key_here
