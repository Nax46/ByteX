# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai_skillpath?retryWrites=true&w=majority

# CORS Configuration (optional, default: *)
CORS_ORIGIN=*

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_at_least_16_characters_long
JWT_EXPIRES_IN=7d
