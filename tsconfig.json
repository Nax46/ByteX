{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist-backend",
    "declaration": true
  },
  "include": ["backend/**/*"],
  "exclude": ["node_modules", "dist", "dist-backend"]
}
